{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sample-scanner",
          "rules": [
            {
              "id": "SQLI-1",
              "name": "sql-injection",
              "shortDescription": {"text": "SQL injection"},
              "fullDescription": {"text": "Tainted data reaches a query"}
            },
            {
              "id": "SECR-1",
              "name": "hardcoded-credential",
              "shortDescription": {"text": "Hard-coded credential"},
              "fullDescription": {"text": "A credential is stored in source"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SQLI-1",
          "level": "error",
          "message": {"text": "user input flows into a query (reported by EMP-004711)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/app/db.py"},
                "region": {"startLine": 12, "startColumn": 5}
              }
            }
          ]
        },
        {
          "ruleId": "SECR-1",
          "level": "warning",
          "message": {"text": "found password=hunter2-TOP-SECRET-token in config"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/app/settings.py"},
                "region": {"startLine": 3, "startColumn": 1}
              }
            }
          ]
        }
      ]
    }
  ]
}
